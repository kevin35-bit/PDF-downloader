<Window x:Class="PDF_downloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDF_downloader"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" ResizeMode="NoResize" Closing="Window_Closing">
    <Grid Background="#FF737373">

        <TextBox x:Name="excel_file_path_textbox" Margin="10,24,116,0" Text="no_file_selected" VerticalAlignment="Top" FontSize="16"/>
        <Label x:Name="label" Content="Excel links file:" HorizontalAlignment="Left" Margin="10,1,0,0" VerticalAlignment="Top" Height="23" Width="180"/>
        <Button x:Name="excel_file_path_btn" Content="open file" Margin="0,24,12,0" VerticalAlignment="Top" Height="23" Click="excel_links_btn_Click" FontSize="14" HorizontalAlignment="Right" Width="99"/>
        <Button x:Name="excel_update_btn" Content="update excel list" HorizontalAlignment="Left" Margin="670,343,0,0" VerticalAlignment="Top" Height="28" Width="120" FontSize="14" Click="excel_update_btn_Click"/>
        <Button x:Name="download_btn" Content="download PDFs" HorizontalAlignment="Left" Margin="670,376,0,0" VerticalAlignment="Top" Height="28" Width="120" FontSize="14" Click="download_btn_Click"/>
        <Button x:Name="reset_btn" Content="reset local list" HorizontalAlignment="Left" Margin="670,310,0,0" VerticalAlignment="Top" Height="28" Width="120" FontSize="14" Click="reset_btn_Click"/>
        <ListBox x:Name="excel_list" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,204,610,10"/>
        <ListBox x:Name="Last_download" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="220,204,400,10"/>
        <ListBox x:Name="not_downloaded" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="424,204,196,10"/>
        <Label x:Name="label_Copy" Content="Excel list:" HorizontalAlignment="Left" Margin="10,174,0,0" VerticalAlignment="Top" Height="25"/>
        <Label x:Name="label_Copy1" Content="last download list:" HorizontalAlignment="Left" Margin="220,174,0,0" VerticalAlignment="Top" Height="25"/>
        <Label x:Name="label_Copy2" Content="not downloaded:" HorizontalAlignment="Left" Margin="424,174,0,0" VerticalAlignment="Top" Height="25"/>
        <TextBox x:Name="output_path_textbox" Margin="10,80,116,0" Text="no_file_selected" VerticalAlignment="Top" FontSize="16"/>
        <Label x:Name="label_Copy3" Content="output path:" HorizontalAlignment="Left" Margin="10,54,0,0" VerticalAlignment="Top" Height="26" Width="280"/>
        <Button x:Name="output_path_btn" Content="select folder" Margin="0,80,12,0" VerticalAlignment="Top" Height="23" Click="output_path_btn_Click" FontSize="14" HorizontalAlignment="Right" Width="99"/>
        <Label x:Name="not_downloaded_count_label" Content="count: 0" HorizontalAlignment="Left" Margin="551,174,0,0" VerticalAlignment="Top" Height="25"/>
        <TextBox x:Name="excel_downloaded_list_path_textbox" Margin="10,137,116,0" Text="no_file_selected" VerticalAlignment="Top" FontSize="16"/>
        <Label x:Name="label_Copy5" Content="excel downloaded list file:" HorizontalAlignment="Left" Margin="10,111,0,0" VerticalAlignment="Top" Height="26" Width="280"/>
        <Button x:Name="excel_downloaded_list_path_btn" Content="select file" Margin="0,137,12,0" VerticalAlignment="Top" Height="23" Click="excel_downloaded_list_path_btn_Click" FontSize="14" HorizontalAlignment="Right" Width="99"/>
    </Grid>

</Window>
