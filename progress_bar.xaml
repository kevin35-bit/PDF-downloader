<Window x:Class="PDF_downloader.progress_bar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDF_downloader"
        mc:Ignorable="d"
        Title="progress_bar" Height="75" Width="200
        ">
    <Grid Background="#FFB5B5B5">
        <ProgressBar x:Name="download_progressbar" HorizontalAlignment="Center" Height="20" VerticalAlignment="Top" Width="180" Margin="0,29,0,0"/>
        <Label x:Name="label" Content="Label" HorizontalAlignment="Left" Margin="10,4,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
